{
  "schemaVersion": "1.4",
  "name": "MKDotNet Project Template",
  "description": "A technology-neutral repository governance and AI-context template with an isolated implementation boundary and guided lifecycle tooling.",
  "repository": "https://github.com/mkdotnet/project-template",
  "type": "project-template",
  "documentationRoot": "docs",
  "implementation": {
    "root": "implementation",
    "topology": "project-defined"
  },
  "toolkit": {
    "bootstrap": "Initialize.ps1",
    "windowsLauncher": "Initialize-MKProject.cmd",
    "source": ".mk/toolkit",
    "installedPath": ".mk/scripts",
    "reportsPath": ".mk/reports"
  },
  "entryPoints": {
    "readme": "README.md",
    "changelog": "CHANGELOG.md",
    "adoptionGuide": "docs/reference/adoption-guide.md",
    "vision": "docs/project/vision.md",
    "roadmap": "docs/project/roadmap.md",
    "status": "docs/project/status.md",
    "capabilities": "docs/project/capabilities.md",
    "architecture": "docs/architecture/overview.md",
    "documentationStandard": "docs/standards/documentation.md",
    "codingStandards": "docs/standards/coding.md",
    "aiBootstrap": "docs/ai/bootstrap.md",
    "aiCollaboration": "docs/ai/collaboration.md",
    "aiReviewChecklist": "docs/ai/review-checklist.md",
    "codeIntelligence": "docs/tooling/code-intelligence.md",
    "graphifyMcpSetup": "docs/tooling/mcp-setup.md",
    "lifecycleToolkit": "docs/tooling/lifecycle-scripts.md",
    "developerGuides": "docs/guides/developer/README.md",
    "userGuides": "docs/guides/user/README.md",
    "moduleContext": "docs/modules/README.md"
  },
  "ai": {
    "canonicalInstructions": "docs/ai/bootstrap.md",
    "collaboration": "docs/ai/collaboration.md",
    "assistants": {
      "codex": { "entryPoint": "AGENTS.md" },
      "claudeCode": { "entryPoint": "CLAUDE.md" },
      "cursor": { "entryPoint": "AGENTS.md" }
    }
  },
  "codeIntelligence": {
    "primary": "graphify",
    "analysisRoot": "implementation",
    "optional": ["sourcegraph"],
    "policy": "docs/tooling/code-intelligence.md",
    "mcpSetup": "docs/tooling/mcp-setup.md"
  },
  "documentation": {
    "developerGuides": "docs/guides/developer",
    "userGuides": "docs/guides/user",
    "moduleContext": "docs/modules",
    "securityCompliance": { "path": "docs/security", "conditional": true }
  },
  "projectState": {
    "roadmap": "docs/project/roadmap.md",
    "status": "docs/project/status.md",
    "capabilities": "docs/project/capabilities.md"
  },
  "validation": {
    "workflow": ".github/workflows/repository-validation.yml",
    "script": ".github/scripts/validate_repository.py"
  },
  "templateVersion": "0.8.0"
}
